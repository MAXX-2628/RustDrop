{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaxxDrop",
  "version": "0.2.0",
  "identifier": "app.maxxdrop.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MaxxDrop",
        "visible": false,
        "width": 1040,
        "height": 700,
        "minWidth": 420,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Devmaxx J4K",
    "copyright": "Copyright (c) 2026 Devmaxx J4K",
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
