<?xml version="1.0" encoding="utf-8"?>
<!-- Direct Share: paired devices (dynamic shortcuts in this category) show in the share sheet. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="app.rustdrop.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="app.rustdrop.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
